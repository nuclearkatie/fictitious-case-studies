<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
<!--                       Reprocessing                           -->
<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->

<facility>
    <name>ModelReprocessingReceiver</name>
    <config>
        <Storage>
            <in_commods><val>UsedRecycledFuelStored</val></in_commods>
            <out_commods><val>UsedRecycledFuelRepReceived</val></out_commods>
            <discrete_handling>0</discrete_handling>
        </Storage>
    </config>
</facility>

<facility>
    <name>ModelReprocessing</name>
    <config>
        <Separations>
            <feedbuf_size>1e10</feedbuf_size>
            <feed_commods>
                <val>UsedRecycledFuelRepReceived</val>
                <val>ForeignRecycledFuel</val>
            </feed_commods>
            <leftover_commod>FissionProducts</leftover_commod>
            <streams>
                <item>
                    <commod>RecycledActinides</commod>
                    <info>
                        <buf_size>1e9</buf_size>
                        <efficiencies>
                            <item><comp>Th</comp><eff>0.99</eff></item>
                            <item><comp>Pa</comp><eff>0.99</eff></item>
                            <item><comp>U</comp><eff>0.99</eff></item>
                            <item><comp>Np</comp><eff>0.99</eff></item>
                            <item><comp>Pu</comp><eff>0.99</eff></item>
                            <item><comp>Am</comp><eff>0.99</eff></item>
                            <item><comp>Cm</comp><eff>0.99</eff></item>
                        </efficiencies>
                    </info>
                </item>
                <item>
                    <commod>Oxygen</commod>
                    <info>
                        <buf_size>1e9</buf_size>
                        <efficiencies>
                            <item><comp>O</comp><eff>0.999999999</eff></item>
                        </efficiencies>
                    </info>
                </item>
            </streams>
        </Separations>
    </config>
</facility>

<facility>
    <name>ReprocessingOxideMixer</name>
    <config>
        <Mixer>
            <in_streams>
                <stream>
                    <info>
                        <mixing_ratio>0.844</mixing_ratio>
                        <buf_size>1e99</buf_size>
                    </info>
                    <commodities>
                        <item>
                            <commodity>RecycledActinides</commodity>
                            <pref>1</pref>
                        </item>
                    </commodities>
                </stream>
                <stream>
                    <info>
                        <mixing_ratio>0.120</mixing_ratio>
                        <buf_size>1e99</buf_size>
                    </info>
                    <commodities>
                        <item>
                            <commodity>Oxygen</commodity>
