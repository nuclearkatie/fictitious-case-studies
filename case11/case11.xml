<!-- case11-->

<simulation>
<control>
    <startmonth>1</startmonth>
    <startyear>2025</startyear>
    <dt>86400</dt>
    <duration>3650</duration>
    <explicit_inventory>1</explicit_inventory>
    <explicit_inventory_compact>0</explicit_inventory_compact>
    <tolerance_resource>0.001</tolerance_resource>
</control>

<archetypes>
    <spec><lib>cycamore</lib><name>Source</name></spec>
    <spec><lib>cycamore</lib><name>Storage</name></spec>
    <spec><lib>cycamore</lib><name>Sink</name></spec>
    <spec><lib>cycamore</lib><name>Enrichment</name></spec>
    <spec><lib>cycamore</lib><name>Separations</name></spec>
    <spec><lib>cycamore</lib><name>Mixer</name></spec>
    <spec><lib>cycamore</lib><name>FuelFab</name></spec>
    <spec><lib>cycamore</lib><name>Reactor</name></spec>
    <spec><lib>agents</lib><name>NullRegion</name></spec>
    <spec><lib>agents</lib><name>NullInst</name></spec>
    <spec><lib>cycamore</lib><name>DeployInst</name></spec>
</archetypes>

<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
<!--                   Importers/Exporters                        -->
<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->

<facility>
    <name>ForeignLWRFuelSource</name>
    <config>
        <Source>
            <outcommod>ForeignRecycledFuel</outcommod>
            <outrecipe>recycled_fuel</outrecipe>
            <inventory_size>4853316</inventory_size> <!-- 436798.5 per reactor -->
        </Source>
    </config>
</facility>

<facility>
    <name>ForeignUO2Source</name>
    <config>
        <Source>
            <outcommod>NUO2</outcommod>
            <outrecipe>natural_uo2</outrecipe>
        </Source>
    </config>
</facility>

<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
<!--                      Mining/Milling                          -->
<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->

<facility>
    <name>ThO2Mill</name>
    <config>
        <Source>
            <outcommod>ThO2</outcommod>
            <outrecipe>natural_tho2</outrecipe>
            <package>ThO2_drum</package>
            <transport_unit>ThO2_container</transport_unit>
        </Source>
    </config>
</facility>

<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
<!--                          Fuel Fab                            -->
<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->

<facility>
    <name>FuelFab</name>
    <config>
        <Mixer>
            <in_streams>
                <stream>
                    <info>
                        <mixing_ratio>0.964</mixing_ratio>
                        <buf_size>1e99</buf_size>
                    </info>
                    <commodities>
                        <item>
                            <commodity>ActinideOxide</commodity>
                            <pref>1</pref>
                        </item>
                    </commodities>
                </stream>
                <stream>
                    <info>
                        <mixing_ratio>0.0178</mixing_ratio>
                        <buf_size>1e5</buf_size>
                    </info>
                    <commodities>
                        <item>
                            <commodity>NUO2</commodity>
                            <pref>1</pref>
                        </item>
                    </commodities>
                </stream>
                <stream>
                    <info>
                        <mixing_ratio>0.0182</mixing_ratio>
                        <buf_size>1e5</buf_size>
                    </info>
                    <commodities>
                        <item>
                            <commodity>ThO2</commodity>
                            <pref>1</pref>
                        </item>
                    </commodities>
                </stream>
            </in_streams>
            <out_commod>RecycledFuel_Process</out_commod>
        </Mixer>
    </config>
</facility>

<facility>
    <name>FuelFabShipper</name>
    <config>
        <Storage>
            <in_commods><val>RecycledFuel_Process</val></in_commods>
            <out_commods><val>RecycledFuel</val></out_commods>
            <package>recycled_fuel_package</package>
            <transport_unit>recycled_fuel_tu</transport_unit>
        </Storage>
    </config>
</facility>

