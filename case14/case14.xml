<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
<!--               Packages and Transport Units                   -->
<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->

<package>
    <name>recycled_fuel_package</name>
    <fill_min>201.6000000001</fill_min>
    <fill_max>201.6000000001</fill_max>
    <strategy>first</strategy>
</package>

<transportunit>
    <name>recycled_fuel_package</name>
    <fill_min>2</fill_min>
    <fill_max>2</fill_max>
    <strategy>first</strategy>
</transportunit>

<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
<!--                         Regions                              -->
<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->

<region>
    <name>SingleRegion</name>
    <config><NullRegion/></config>
    <institution>
        <name>SingleInstitution</name>
        <initialfacilitylist>
            <entry>
                <prototype>ThFuelSource</prototype>
                <number>1</number>
            </entry>
            <entry>
                <prototype>ModelRx</prototype>
                <number>1</number>
            </entry>
            <entry>
                <prototype>ModelSaltTreatment</prototype>
                <number>1</number>
            </entry>
            <entry>
                <prototype>ModelChemicalSeparation</prototype>
                <number>1</number>
            </entry>
            <entry>
                <prototype>FuelMakeupMixer</prototype>
                <number>1</number>
            </entry>
            <entry>
                <prototype>FPStorage</prototype>
                <number>1</number>
            </entry>
        </initialfacilitylist>
        <config><NullInst/></config>
    </institution>
    <institution>
        <name>DeployInst</name>
        <config>
            <DeployInst>
                <prototypes>
                    <val>InitialFuelLoad</val>
                </prototypes>
                <build_times>
                    <val>-1</val>
                </build_times>
                <n_build>
                    <val>1</val>
                </n_build>
                <lifetimes>
                    <val>10</val> <!-- at least one cycle -->
                </lifetimes>
            </DeployInst>
        </config>
    </institution>
</region>

</simulation>
