<!-- case11-->

<simulation>
<control>
    <startmonth>1</startmonth>
    <startyear>2025</startyear>
    <dt>86400</dt>
    <duration>365</duration>
    <explicit_inventory>1</explicit_inventory>
    <explicit_inventory_compact>0</explicit_inventory_compact>
    <tolerance_resource>0.001</tolerance_resource>
</control>

<archetypes>
    <spec><lib>cycamore</lib><name>Source</name></spec>
    <spec><lib>cycamore</lib><name>Storage</name></spec>
    <spec><lib>cycamore</lib><name>Sink</name></spec>
    <spec><lib>cycamore</lib><name>Enrichment</name></spec>
    <spec><lib>cycamore</lib><name>Separations</name></spec>
    <spec><lib>cycamore</lib><name>Mixer</name></spec>
    <spec><lib>cycamore</lib><name>FuelFab</name></spec>
    <spec><lib>cycamore</lib><name>Reactor</name></spec>
    <spec><lib>agents</lib><name>NullRegion</name></spec>
    <spec><lib>agents</lib><name>NullInst</name></spec>
    <spec><lib>cycamore</lib><name>DeployInst</name></spec>
</archetypes>

<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
<!--                   Importers/Exporters                        -->
<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->

<facility>
    <name>ThFuelSource</name>
    <config>
        <Source>
            <outcommod>ThFuel</outcommod>
            <outrecipe>Th_makeup_fuel</outrecipe>
        </Source>
    </config>
</facility>

<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
<!--                         Reactors                             -->
<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->

<facility>
    <name>InitialFuelLoad</name>
    <config>
        <Storage>
            <in_commods>
                <val>ThFuel</val>
            </in_commods>
            <out_commods>
                <val>RecycledFuel</val>
            </out_commods>
            <cumulative_cap>69604</cumulative_cap>
            <dormant_buying_frequency_type>Fixed</dormant_buying_frequency_type>
            <dormant_buying_val>100</dormant_buying_val>
        </Storage>
    </config>
</facility>

<facility>
    <name>ModelRx</name>
    <config>
        <Reactor>
            <fuel_incommods>
                <val>RecycledFuel</val>
            </fuel_incommods>
            <fuel_inrecipes>
                <val>Th_makeup_fuel</val>
            </fuel_inrecipes>
            <fuel_outcommods>
                <val>UsedRecycledFuel</val>
            </fuel_outcommods>
            <fuel_outrecipes>
                <val>discharged_fuel</val>
            </fuel_outrecipes>
            <assem_size>34752</assem_size> 
            <n_assem_batch>1</n_assem_batch>
            <n_assem_core>1</n_assem_core>
            <cycle_time>5</cycle_time>
            <refuel_time>0</refuel_time>
        </Reactor>
    </config>
</facility>

<facility>
    <name>ModelSaltTreatment</name>
    <config>
        <Separations>
            <feedbuf_size>1e10</feedbuf_size>
            <feed_commods><val>UsedRecycledFuel</val></feed_commods>
            <leftover_commod>DF1</leftover_commod>
            <streams>
                <!-- Noble metals -->
                <item>
                    <commod>FP1_noble_metals</commod>
                    <info>
                        <buf_size>1e9</buf_size>
                        <efficiencies>
                            <item><comp>Mo</comp><eff>0.999999999999</eff></item>
                            <item><comp>Te</comp><eff>0.999999999999</eff></item>
                            <item><comp>Nb</comp><eff>0.999999999999</eff></item>
                            <item><comp>Ru</comp><eff>0.999999999999</eff></item>
                            <item><comp>Tc</comp><eff>0.999999999999</eff></item>
                            <item><comp>Se</comp><eff>0.999999999999</eff></item>
                        </efficiencies>
                    </info>
                </item>
                <!-- Seminoble metals -->
                <item>
                    <commod>FP1_seminoble_metals</commod>
                    <info>
                        <buf_size>1e9</buf_size>
                        <efficiencies>
                            <item><comp>Zr</comp><eff>0.05</eff></item>
                        </efficiencies>
                    </info>
                </item>
                <!-- Gases -->
                <item>
                    <commod>FP1_gases</commod>
                    <info>
                        <buf_size>1e9</buf_size>
                        <efficiencies>
                            <item><comp>Xe</comp><eff>0.999999999999</eff></item>
                            <item><comp>Kr</comp><eff>0.999999999999</eff></item>
                        </efficiencies>
                    </info>
                </item>
                <!-- Volatile fluories -->
                <item>
                    <commod>FP_volatile_fluorides</commod>
                    <info>
                        <buf_size>1e9</buf_size>
                        <efficiencies>
                            <item><comp>I</comp><eff>0.166666666667</eff></item>
                            <item><comp>Br</comp><eff>0.166666666667</eff></item>
                        </efficiencies>
                    </info>
                </item>
            </streams>
        </Separations>
    </config>
</facility>

<facility>
    <name>ModelChemicalSeparation</name>
    <config>
        <Separations>
            <feedbuf_size>1e10</feedbuf_size>
            <feed_commods><val>DF1</val></feed_commods>
            <leftover_commod>FP2</leftover_commod>
            <streams>
                <item>
                    <commod>Actinides</commod>
                    <info>
                        <buf_size>1e9</buf_size>
                        <efficiencies>
                            <item><comp>Th</comp><eff>0.999999999</eff></item>
                            <item><comp>Pa</comp><eff>0.999999999</eff></item>
                            <item><comp>U</comp><eff>0.992</eff></item>
                            <item><comp>Np</comp><eff>0.992</eff></item>
                            <item><comp>Pu</comp><eff>0.992</eff></item>
                            <item><comp>Am</comp><eff>0.992</eff></item>
                            <item><comp>Cm</comp><eff>0.992</eff></item>
                        </efficiencies>
                    </info>
                </item>
            </streams>
        </Separations>
    </config>
</facility>

<facility>
    <name>FuelMakeupMixer</name>
    <config>
        <Mixer>
            <in_streams>
                <stream>
                    <info>
                        <mixing_ratio>0.983771239</mixing_ratio>
                        <buf_size>34188.6</buf_size>
                    </info>
                    <commodities>
                        <item>
                            <commodity>Actinides</commodity>
                            <pref>1</pref>
                        </item>
                    </commodities>
                </stream>
                <stream>
                    <info>
                        <mixing_ratio>0.01586332</mixing_ratio>
                        <buf_size>551.3</buf_size>
                    </info>
                    <commodities>
                        <item>
                            <commodity>FP2</commodity>
                            <pref>1</pref>
                        </item>
                    </commodities>
                </stream>
                <stream>
                    <info>
                        <mixing_ratio>0.0003675441</mixing_ratio>
                        <buf_size>1e4</buf_size>
                    </info>
                    <commodities>
                        <item>
                            <commodity>ThFuel</commodity>
                            <pref>1</pref>
                        </item>
                    </commodities>
                </stream>
            </in_streams>
            <out_commod>RecycledFuel</out_commod>
            <out_buf_size>34752.51</out_buf_size>
        </Mixer>
    </config>
</facility>

<facility>
    <name>FPStorage</name>
    <config>
        <Storage>
            <in_commods>
                <val>FP2</val>
            </in_commods>
            <in_commod_prefs>
                <val>0.1</val>
            </in_commod_prefs>
            <out_commods>
                <val>FP2_stored</val>
            </out_commods>
            <throughput>6.1</throughput>
        </Storage>
    </config>
</facility>

