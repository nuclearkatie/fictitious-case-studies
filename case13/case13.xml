<!-- case11-->

<simulation>
<control>
    <startmonth>1</startmonth>
    <startyear>2025</startyear>
    <dt>86400</dt>
    <duration>3650</duration>
    <explicit_inventory>1</explicit_inventory>
    <explicit_inventory_compact>0</explicit_inventory_compact>
    <tolerance_resource>0.001</tolerance_resource>
</control>

<archetypes>
    <spec><lib>cycamore</lib><name>Source</name></spec>
    <spec><lib>cycamore</lib><name>Storage</name></spec>
    <spec><lib>cycamore</lib><name>Sink</name></spec>
    <spec><lib>cycamore</lib><name>Enrichment</name></spec>
    <spec><lib>cycamore</lib><name>Separations</name></spec>
    <spec><lib>cycamore</lib><name>Mixer</name></spec>
    <spec><lib>cycamore</lib><name>FuelFab</name></spec>
    <spec><lib>cycamore</lib><name>Reactor</name></spec>
    <spec><lib>agents</lib><name>NullRegion</name></spec>
    <spec><lib>agents</lib><name>NullInst</name></spec>
    <spec><lib>cycamore</lib><name>DeployInst</name></spec>
</archetypes>

<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
<!--                            Foreign                           -->
<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->

<facility>
    <name>ForeignThF4Receiver</name>
    <config>
        <Storage>
            <in_commods><val>ThF4</val></in_commods>
            <in_commod_prefs><val>0.1</val></in_commod_prefs>
            <out_commods><val>ThF4_foreign</val></out_commods>
        </Storage>
    </config>
</facility>

<facility>
    <name>ForeignInitialFuelShipper</name>
    <config>
        <Source>
            <outcommod>ThFuel</outcommod>
            <outrecipe>ThF4</outrecipe>
            <inventory_size>1e99</inventory_size>
        </Source>
    </config>
</facility>

<facility>
    <name>ForeignHALEUTrainingFuelFabShipper</name>
    <config>
        <Source>
            <outcommod>HALEUO2_fuel_training</outcommod>
            <outrecipe>HALEU_8-5_UZr_fuel</outrecipe>
            <package>Tr_RR</package>
        </Source>
    </config>
</facility>

<facility>
    <name>ForeignHALEUMedicalFuelFabShipper</name>
    <config>
        <Source>
            <outcommod>HALEUO2_fuel_medical</outcommod>
            <outrecipe>HALEU_19-9_UO2_fuel</outrecipe>
            <package>HP_RR</package>
        </Source>
    </config>
</facility>

<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
<!--                             Mill                             -->
<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->

<facility>
    <name>ThMill</name>
    <config>
        <Source>
            <outcommod>ThO2_powder</outcommod>
            <outrecipe>Th</outrecipe>
            <inventory_size>1e99</inventory_size>
            <throughput>3340</throughput>
        </Source>
    </config>
</facility>

<facility>
    <name>ThMillShipper</name>
    <config>
        <Storage>
            <in_commods>
                <val>ThO2_powder</val>
            </in_commods>
            <out_commods>
                <val>ThO2</val>
            </out_commods>
            <max_inv_size>168000</max_inv_size>
            <throughput>3340</throughput>
            <residence_time>0</residence_time>
            <package>ThO2_drum</package>
            <transport_unit>ThO2_pallet</transport_unit>
        </Storage>
    </config>
</facility>


<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
<!--                         Conversion                           -->
<!-- xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->

<!-- Size: XS (Th) -->
<facility>
    <name>ConversionReciever</name>
    <config>
        <Storage>
            <in_commods>
                <val>ThO2</val>
            </in_commods>
            <out_commods>
                <val>ThO2_received</val>
            </out_commods>
            <residence_time>0</residence_time>
            <throughput>27400</throughput>
            <max_inv_size>46306</max_inv_size>
        </Storage>
    </config>
</facility>

<facility>
    <name>ConversionTh</name>
    <config>
        <Separations>
            <feed_commods>
                <val>ThO2_received</val>
            </feed_commods>
            <feed_recipe>ThO2</feed_recipe>
            <feedbuf_size>46306</feedbuf_size>
            <throughput>27400</throughput>
            <leftover_commod>extra_oxygen</leftover_commod>
            <leftoverbuf_size>1e199</leftoverbuf_size>
            <streams>
                <item>
                    <commod>natural_th</commod>
                    <info>
                        <buf_size>46306</buf_size>
                        <efficiencies>
                            <item>
                                <comp>Th</comp>
                                <eff>0.999999</eff>
                            </item>
                        </efficiencies>
                    </info>
                </item>
            </streams>
        </Separations>
    </config>
</facility>

<facility>
    <name>ConversionThF4Mixer</name>
    <config>
        <Mixer>
        <in_streams>
            <stream>
                <info>
                    <mixing_ratio>0.676</mixing_ratio>
                    <buf_size>46306</buf_size>
                </info>
                <commodities>
                    <item>
                        <commodity>natural_th</commodity>
                        <pref>1</pref>
                    </item>
                </commodities>
            </stream>
            <stream>
                <info>
                    <mixing_ratio>0.324</mixing_ratio>
                    <buf_size>1.00E+99</buf_size>
                </info>
                <commodities>
                    <item>
                        <commodity>fluorine</commodity>
                        <pref>1</pref>
                    </item>
                </commodities>
            </stream>
        </in_streams>
        <out_commod>ThF4_preshipped</out_commod>
        <out_buf_size>2.74E+04</out_buf_size>
        <throughput>13700</throughput>
        </Mixer>
    </config>
</facility>

<facility>
    <name>ConversionShipper</name>
    <config>
        <Storage>
            <in_commods>
                <val>ThF4_preshipped</val>
            </in_commods>
            <out_commods>
                <val>ThF4</val>
            </out_commods>
            <residence_time>0</residence_time>
            <throughput>137000</throughput>
            <max_inv_size>137000</max_inv_size>
            <!-- <package>ThF4_package</package> -->
        </Storage>
    </config>
</facility>

